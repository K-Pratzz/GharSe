# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/gharse

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Default platform commission (%) - can be overridden via admin dashboard (stored in PlatformConfig doc)
DEFAULT_COMMISSION_PERCENT=15

# Image uploads - MVP stores locally in /uploads and serves statically.
# To switch to a cloud provider later (e.g. Cloudinary), set these and swap the
# implementation in services/imageStorage.js — the rest of the app only calls
# that abstraction, so no other file needs to change.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
